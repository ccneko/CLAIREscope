# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual Environments
.venv/
env/
venv/

# Data Files & Single-Cell Objects (NEVER COMMIT PRIVATE LAB DATA)
*.h5ad
*.h5
*.loom
*.rds
*.RData
*.csv
*.tsv
*.parquet
*.feather
*.zarr
*.mtx
*.tar.gz
*.zip
data/
datasets/
raw_data/
processed_data/

# Allow public open-access demo dataset for Streamlit Cloud deployment
!data/
!data/demo_skin_atlas/
!data/demo_skin_atlas/**

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Streamlit Local Config
.streamlit/secrets.toml

# Logs & Streamlit server output
*.log
streamlit.log

# User Custom Configurations (Never commit private lab configs)
config/user/*
!config/user/.gitkeep
!config/user/README.md

dataset_config.yaml
*_cell_type_markers.yaml
